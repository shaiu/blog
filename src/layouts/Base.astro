---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/lato/latin-400.css';
import '@fontsource/lato/latin-700.css';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  markdownUrl?: string;
  jsonLd?: Record<string, unknown>;
  article?: boolean;
}

const { title, description = SITE.description, markdownUrl, jsonLd, article = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} (RSS)`} href="/rss.xml" />
    <link rel="alternate" type="application/feed+json" title={`${SITE.title} (JSON Feed)`} href="/feed.json" />
    {markdownUrl && <link rel="alternate" type="text/markdown" href={markdownUrl} />}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta name="twitter:card" content="summary" />
    <meta name="color-scheme" content="light dark" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <a class="name" href="/">{SITE.title}</a>
      <nav aria-label="Main">
        <a href="/">Notes</a>
        <a href="/about/">About</a>
        <a href="/agents/">For agents</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site">
      <span>{SITE.author}</span>
      <span>For your agent: <a href="/feed.json">feed</a> · <a href="/rss.xml">RSS</a> · <a href="/skill.md">skill</a></span>
    </footer>
  </body>
</html>

<style is:global>
  /* Tokens: from the Shai Ungar Blog design system. Light first, dark by system setting. */
  :root {
    --ground: #f7f5f0;
    --surface: #fdfcf9;
    --ink: #33322f;
    --ink-strong: #1f1e1c;
    --muted: #6b6862;
    --line: #dedad2;
    --accent: #b23a1e;
    --label: #00758f;
    --font-serif: 'Newsreader Variable', Georgia, serif;
    --font-sans: Lato, system-ui, sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 14px;
    --space-4: 20px;
    --space-5: 30px;
    --space-6: 44px;
    --space-7: 56px;
    --space-8: 72px;
    --radius-sm: 3px;
    --radius-md: 6px;
    --measure: 640px;
    --margin-column: 220px;
    --column-gap: 64px;
    --page-max: 1040px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --ground: #1b1a17;
      --surface: #24231f;
      --ink: #d8d4cc;
      --ink-strong: #eeeae1;
      --muted: #a39e95;
      --line: #3a3733;
      --accent: #ff8f73;
      --label: #45bccd;
    }
    .astro-code,
    .astro-code span {
      color: var(--shiki-dark) !important;
      background-color: transparent !important;
    }
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    background: var(--ground);
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.6;
    font-optical-sizing: auto;
    text-rendering: optimizeLegibility;
  }
  a {
    color: var(--accent);
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }
  a:hover {
    text-decoration-thickness: 2px;
  }
  img {
    max-width: 100%;
    height: auto;
  }
  .skip {
    position: absolute;
    left: -999px;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    background: var(--surface);
    padding: 0.5rem;
  }
  header.site,
  main,
  footer.site {
    max-width: var(--page-max);
    margin: 0 auto;
    padding-left: 28px;
    padding-right: 28px;
  }
  header.site {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px 24px;
    padding-top: 34px;
    padding-bottom: 20px;
  }
  header.site .name {
    font: 600 22px/1.2 var(--font-serif);
    color: var(--ink-strong);
    text-decoration: none;
  }
  header.site nav {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    font: 400 15px/1.4 var(--font-sans);
  }
  header.site nav a {
    color: var(--ink);
    text-decoration: none;
  }
  header.site nav a:hover {
    color: var(--accent);
  }
  main {
    padding-top: var(--space-7);
    padding-bottom: var(--space-8);
  }
  footer.site {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    padding-bottom: 64px;
    font: 400 14px/1.45 var(--font-sans);
    color: var(--muted);
  }
  footer.site::before {
    content: '';
    flex: 0 0 100%;
    border-top: 1px solid var(--line);
    margin-bottom: 6px;
  }

  /* Post header */
  .fn-kicker {
    margin: 0 0 16px;
    font: 700 12px/1.4 var(--font-sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .fn-kicker span {
    color: var(--muted);
    font-weight: 400;
  }
  .fn-title {
    margin: 0;
    max-width: 820px;
    font: 600 62px/1.08 var(--font-serif);
    letter-spacing: -0.012em;
    color: var(--ink-strong);
    text-wrap: balance;
  }
  .fn-subtitle {
    margin: 18px 0 0;
    max-width: 700px;
    font: 300 27px/1.35 var(--font-serif);
    color: var(--ink);
  }
  .fn-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: var(--space-5);
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font: 400 14px/1.45 var(--font-sans);
    color: var(--accent);
  }
  .fn-tags .right {
    margin-left: auto;
    color: var(--muted);
  }

  /* Columns */
  .fn-columns {
    display: flex;
    flex-wrap: wrap;
    gap: 40px var(--column-gap);
    margin-top: var(--space-7);
  }
  .fn-main {
    flex: 999 1 560px;
    min-width: 0;
    max-width: var(--measure);
  }
  .fn-margin {
    flex: 1 1 var(--margin-column);
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-top: 8px;
  }

  /* The brief */
  .fn-brief {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 6px 22px;
    margin: 0 0 var(--space-6);
    font: 400 17px/1.5 var(--font-serif);
  }
  .fn-brief__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    padding: var(--space-3) 0;
  }
  .fn-brief__row + .fn-brief__row {
    border-top: 1px solid var(--line);
  }
  .fn-brief__label {
    flex: none;
    width: 130px;
    font: 700 12px/2.1 var(--font-sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--label);
  }
  .fn-brief__text {
    flex: 1 1 300px;
    min-width: 0;
  }

  /* Margin figure */
  .fn-figure {
    border-top: 1px solid var(--line);
    padding-top: 12px;
  }
  .fn-figure__value {
    margin: 0;
    font: 300 50px/1 var(--font-serif);
    color: var(--ink-strong);
  }
  .fn-figure__caption {
    margin: var(--space-2) 0 0;
    font: 400 14px/1.45 var(--font-sans);
    color: var(--muted);
  }

  /* Prose */
  .fn-prose {
    max-width: var(--measure);
  }
  .fn-prose p,
  .fn-prose ul,
  .fn-prose blockquote,
  .fn-prose table,
  .fn-prose pre {
    margin: 0 0 24px;
  }
  .fn-prose h1 {
    margin: 0 0 12px;
    font: 600 46px/1.1 var(--font-serif);
    letter-spacing: -0.012em;
    color: var(--ink-strong);
  }
  .fn-prose h2 {
    margin: var(--space-7) 0 12px;
    font: 300 38px/1.2 var(--font-serif);
    color: var(--ink-strong);
  }
  .fn-prose h3 {
    margin: var(--space-6) 0 8px;
    font: 400 26px/1.3 var(--font-serif);
    color: var(--ink-strong);
  }
  .fn-prose li {
    margin-bottom: 6px;
  }
  /* Numbered lists in a post are set as the rule list. */
  .fn-prose ol {
    list-style: none;
    counter-reset: rule;
    margin: 0 0 30px;
    padding: 0;
    border-bottom: 1px solid var(--line);
  }
  .fn-prose ol > li {
    counter-increment: rule;
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    margin: 0;
    padding: var(--space-3) 0;
    border-top: 1px solid var(--line);
  }
  .fn-prose ol > li::before {
    content: counter(rule);
    flex: none;
    width: 30px;
    font: italic 300 34px/1 var(--font-serif);
    color: var(--accent);
  }
  .fn-prose code {
    font: 400 0.78em/1.55 var(--font-mono);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.08em 0.3em;
  }
  .fn-prose pre {
    font: 400 15px/1.55 var(--font-mono);
    background: var(--surface) !important;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 16px 18px;
    overflow-x: auto;
  }
  .fn-prose pre code {
    background: none;
    border: 0;
    padding: 0;
    font-size: inherit;
  }
  .fn-prose blockquote {
    margin-left: 0;
    padding-left: var(--space-4);
    border-left: 1px solid var(--line);
    font-style: italic;
    color: var(--muted);
  }
  .fn-prose table {
    width: 100%;
    border-collapse: collapse;
    font: 400 15px/1.45 var(--font-sans);
    display: block;
    overflow-x: auto;
  }
  .fn-prose th,
  .fn-prose td {
    text-align: left;
    padding: 10px 14px 10px 0;
    border-bottom: 1px solid var(--line);
  }
  .fn-prose hr {
    border: 0;
    border-top: 1px solid var(--line);
    margin: var(--space-7) 0;
  }
  .fn-dropcap > p:first-of-type::first-letter {
    float: left;
    font: 600 84px/0.8 var(--font-serif);
    padding: 8px 4px 0 0;
    color: var(--ink-strong);
  }
  .fn-lede {
    margin: 0 0 var(--space-6);
    max-width: 700px;
    font: 300 27px/1.35 var(--font-serif);
  }

  /* Post list */
  .fn-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 760px;
  }
  .fn-list li {
    padding: 26px 0;
    border-top: 1px solid var(--line);
  }
  .fn-list time {
    font: 400 14px/1.45 var(--font-sans);
    color: var(--muted);
  }
  .fn-list h2 {
    margin: 6px 0 8px;
    font: 600 32px/1.15 var(--font-serif);
    letter-spacing: -0.01em;
  }
  .fn-list h2 a {
    color: var(--ink-strong);
    text-decoration: none;
  }
  .fn-list h2 a:hover {
    color: var(--accent);
  }
  .fn-list p {
    margin: 0;
    font-size: 19px;
    line-height: 1.5;
  }

  /* Copy boxes on the agents page */
  .copybox {
    position: relative;
  }
  .copybox button {
    position: absolute;
    top: 8px;
    right: 8px;
    min-height: 32px;
    font: 700 12px/1 var(--font-sans);
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--ground);
    color: var(--ink);
    cursor: pointer;
  }
  .copybox pre {
    white-space: pre-wrap;
    padding-top: 46px;
  }

  @media (max-width: 640px) {
    body {
      font-size: 18px;
    }
    header.site,
    main,
    footer.site {
      padding-left: 20px;
      padding-right: 20px;
    }
    .fn-title {
      font-size: 40px;
    }
    .fn-subtitle,
    .fn-lede {
      font-size: 22px;
    }
    .fn-prose h1 {
      font-size: 36px;
    }
    .fn-prose h2 {
      font-size: 30px;
    }
  }
</style>
