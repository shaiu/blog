---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
import portrait from '../assets/shai-funko.png';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  url: `${SITE.url}/about/`,
  jobTitle: 'Staff Software Engineer',
  worksFor: { '@type': 'Organization', name: 'Riskified' },
  sameAs: [SITE.linkedin],
};
---

<Base title="About" jsonLd={jsonLd}>
  <div class="fn-prose">
  <h1>About</h1>
  <Image
    class="portrait"
    src={portrait}
    alt={`${SITE.author} as a Funko Pop-style figure`}
    width={200}
    height={200}
    densities={[2]}
    loading="eager"
  />
  <p>
    I'm a Staff Software Engineer at Riskified with 12+ years in software, previously at Cyren, Behalf and Forcepoint.
    I'm married, with three kids.
  </p>
  <p>
    I love technology, and I'm an early adopter. I keep exploring more every day. Most important, to me all of this is
    fun, like being a kid with new games.
  </p>
  <p>These days most of my thinking goes to one question: what changes when AI agents do real work?</p>
  <p>
    I test it on myself. I run a personal AI assistant on my own server. It reads my inbox, files insurance claims and
    flight-compensation complaints, and can't send or delete anything without my yes. At work I look at the same
    question from the team side: when code is cheap to write, review and trust become the bottleneck.
  </p>
  <p>I share the rules, the numbers and the mistakes.</p>
  <p>Find me on <a href={SITE.linkedin}>LinkedIn</a>, or follow the <a href="/rss.xml">RSS feed</a>.</p>
  </div>
</Base>

<style>
  .portrait {
    float: right;
    margin: 6px 0 var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
  }
  @media (max-width: 640px) {
    .portrait {
      float: none;
      display: block;
      width: 180px;
      margin: 0 0 var(--space-5);
    }
  }
</style>
